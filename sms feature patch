+# ── Twilio helper ────────────────────────────────────────────────────────────
+
+def _twilio_client():
+    sid   = os.getenv("TWILIO_ACCOUNT_SID")
+    token = os.getenv("TWILIO_AUTH_TOKEN")
+    if not sid or not token:
+        raise RuntimeError("TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN must be set in Vercel.")
+    from twilio.rest import Client
+    return Client(sid, token)
+
+def _sms_body(pick: dict) -> str:
+    from datetime import datetime
+    try:
+        exp_fmt = datetime.strptime(pick["expiry"], "%Y-%m-%d").strftime("%b %-d")
+    except Exception:
+        exp_fmt = pick.get("expiry", "")
+    ann = pick.get("annualized", 0) * 100
+    yld = pick.get("yield", 0) * 100
+    otm = pick.get("otm", 0) * 100
+    return (
+        f"📊 Put Scanner — Top Pick\n\n"
+        f"Ticker:     {pick['ticker']}\n"
+        f"Strike:     ${pick['strike']:,.2f} put\n"
+        f"Expires:    {exp_fmt} ({pick['dte']}d)\n"
+        f"Bid:        ${pick['bid']:.2f}  (${pick['premium']:.0f}/contract)\n"
+        f"Collateral: ${pick['collateral']:,.0f}\n"
+        f"Week yield: {yld:.1f}%  ({ann:.0f}% ann.)\n"
+        f"OTM:        {otm:.1f}%  |  Delta: {pick['delta']:.2f}\n"
+        f"IV:         {pick['iv']*100:.0f}%\n\n"
+        f"Not financial advice."
+    )
+
+# ── /api/sms route — add alongside /api/analyze ──────────────────────────────
+
+@app.post("/api/sms")
+def send_sms():
+    body  = request.get_json(silent=True) or {}
+    to    = str(body.get("to", "")).strip()
+    pick  = body.get("pick")
+    from_ = os.getenv("TWILIO_FROM", "")
+    if not re.fullmatch(r"\+1\d{10}", to):
+        return fail(400, "Enter a US number in +1XXXXXXXXXX format.")
+    if not pick or not isinstance(pick, dict) or "ticker" not in pick:
+        return fail(400, "No scan result provided. Run a scan first.")
+    if not from_:
+        return fail(503, "TWILIO_FROM is not set in Vercel.")
+    try:
+        client = _twilio_client()
+        m = client.messages.create(body=_sms_body(pick), from_=from_, to=to)
+    except RuntimeError as e:
+        return fail(503, str(e))
+    except Exception as e:
+        return fail(502, f"Twilio error: {e}")
+    return jsonify({"sid": m.sid, "status": str(m.status)})

