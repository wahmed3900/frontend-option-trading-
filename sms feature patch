# ── JavaScript — add just before </script> ───────────────────────────────────

+(function () {
+    const phoneEl = document.getElementById("sms-phone");
+    const smsBtn  = document.getElementById("sms-btn");
+    const smsMsg  = document.getElementById("sms-msg");
+    try {
+        const saved = localStorage.getItem("sms_phone");
+        if (saved) phoneEl.value = saved;
+    } catch (_) {}
+    function normPhone(raw) {
+        const digits = raw.replace(/\D/g, "");
+        if (digits.length === 10) return "+1" + digits;
+        if (digits.length === 11 && digits[0] === "1") return "+" + digits;
+        return null;
+    }
+    function enableSms() {
+        smsBtn.disabled = !results.length || !normPhone(phoneEl.value || "");
+    }
+    phoneEl.addEventListener("input", enableSms);
+    const observer = new MutationObserver(() => enableSms());
+    observer.observe(document.getElementById("results"), { attributes: true });
+    smsBtn.addEventListener("click", async () => {
+        const to = normPhone(phoneEl.value || "");
+        if (!to) { msg(smsMsg, "Enter a valid US number like +19165550100", "err"); return; }
+        if (!results.length) { msg(smsMsg, "Run a scan first.", "err"); return; }
+        try { localStorage.setItem("sms_phone", phoneEl.value); } catch (_) {}
+        smsBtn.disabled = true; smsBtn.textContent = "Sending…";
+        msg(smsMsg, "");
+        try {
+            await api("/sms", {
+                method: "POST",
+                body: JSON.stringify({ to, pick: results[0] }),
+            });
+            msg(smsMsg, "✓ Sent to " + phoneEl.value, "ok");
+        } catch (e) {
+            msg(smsMsg, e.message, "err");
+        } finally {
+            smsBtn.disabled = false; smsBtn.textContent = "📱 Text me";
+            enableSms();
+        }
+    });
+})();
