+        pick_block = f"""
+        <div style='margin:24px 0;padding:16px 20px;background:#f8fafc;border-left:4px solid #2563eb;border-radius:4px'>
+          <p style='margin:0 0 6px;font-size:13px;color:#555;text-transform:uppercase;letter-spacing:.05em'>AI Pick</p>
+          <p style='margin:0 0 8px;font-size:18px;font-weight:700;color:#111'>
