+@app.get("/api/news")
+def news():
+    import yfinance as yf
+    tickers_param = request.args.get("tickers", "SPY,QQQ,NVDA")
+    tickers = [t.strip().upper() for t in tickers_param.split(",") if t.strip()][:10]
+    seen, items = set(), []
+    for ticker in tickers:
+        try:
+            tk = yf.Ticker(ticker)
+            for n in (tk.news or [])[:5]:
+                uid = n.get("id") or n.get("uuid") or n.get("link", "")
+                if uid in seen:
+                    continue
+                seen.add(uid)
+                content = n.get("content", {}) or {}
+                title = content.get("title") or n.get("title", "")
+                url = (content.get("canonicalUrl", {}) or {}).get("url") or n.get("link") or n.get("url", "")
+                publisher = (content.get("provider", {}) or {}).get("displayName") or n.get("publisher", "")
+                pub_time = content.get("pubDate") or n.get("providerPublishTime", 0)
+                # normalize pub_time to unix int
+                if isinstance(pub_time, str):
+                    try:
+                        from datetime import timezone
+                        pub_time = int(datetime.fromisoformat(pub_time.replace("Z", "+00:00")).timestamp())
+                    except Exception:
+                        pub_time = 0
+                if title and url:
+                    items.append({
+                        "title": title,
+                        "url": url,
+                        "source": publisher,
+                        "published": int(pub_time) if pub_time else 0,
+                        "ticker": ticker,
+                    })
+        except Exception:
+            pass
+    items.sort(key=lambda x: x["published"], reverse=True)
+    return jsonify({"items": items[:25]})
+
