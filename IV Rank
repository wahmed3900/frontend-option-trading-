+def _build_email_html(results, ai):
+    """Return a polished HTML email body for the scan results."""
+    today = datetime.now().strftime("%B %d, %Y")
+    rows = ""
+    for r in results:
+        pct  = f"{r['annualized']*100:.1f}%"
+        prem = f"${r['premium']:.2f}"
+        otm  = f"{r['otm']*100:.1f}%"
+        rows += (
+            f"<tr>"
+            f"<td style='padding:8px 12px;font-weight:600'>{r['ticker']}</td>"
+            f"<td style='padding:8px 12px'>{r['contract']}</td>"
+            f"<td style='padding:8px 12px'>${r['strike']:.2f}</td>"
+            f"<td style='padding:8px 12px'>{r['expiry']} ({r['dte']}d)</td>"
