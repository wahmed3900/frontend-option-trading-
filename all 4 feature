+def iv_rank(closes_1y, current_iv):
+    """Approximate IV rank: where current_iv sits in the 30-day HV range over the past year.
+    Returns 0-100 (higher = IV elevated vs history; good time to sell premium)."""
+    try:
+        import statistics
+        if len(closes_1y) < 32:
+            return None
+        hvs = []
+        for i in range(30, len(closes_1y)):
+            window = closes_1y[i - 30: i]
+            log_rets = [math.log(window[j] / window[j - 1]) for j in range(1, len(window)) if window[j - 1] > 0]
+            if len(log_rets) < 2:
+                continue
+            hv = statistics.stdev(log_rets) * math.sqrt(252)
+            hvs.append(hv)
+        if not hvs:
+            return None
+        lo, hi = min(hvs), max(hvs)
+        if hi <= lo:
+            return None
+        rank = (current_iv - lo) / (hi - lo) * 100
+        return round(max(0.0, min(100.0, rank)), 1)
+    except Exception:
+        return None
+
+
+def earnings_in_window(tk, max_dte):
+    """Return the nearest earnings date string if it falls within max_dte days, else None."""
+    try:
+        cal = tk.calendar
+        if cal is None:
+            return None
+        # calendar can be a dict or a DataFrame depending on yfinance version
+        if hasattr(cal, "to_dict"):
+            cal = cal.to_dict()
+        dates = cal.get("Earnings Date") or cal.get("earningsDate") or []
+        if not dates:
+            return None
+        today = date.today()
+        cutoff = today.toordinal() + max_dte
+        for d in (dates if isinstance(dates, list) else [dates]):
+            if hasattr(d, "date"):
+                d = d.date()
+            if isinstance(d, datetime):
+                d = d.date()
+            if isinstance(d, date) and today <= d and d.toordinal() <= cutoff:
+                return d.strftime("%b %d")
+        return None
+    except Exception:
+        return None
+
