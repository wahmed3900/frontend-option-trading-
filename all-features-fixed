+            f"<td style='padding:8px 12px;color:#16a34a'>{pct} ann.</td>"
+            f"<td style='padding:8px 12px'>{otm} OTM</td>"
+            f"<td style='padding:8px 12px'>{r['delta']:.3f} Δ</td>"
+            f"</tr>"
+        )
+    pick_block = ""
+    if ai:
+        conf_color = {"high": "#16a34a", "medium": "#d97706", "low": "#dc2626"}.get(
